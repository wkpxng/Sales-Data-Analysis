            <column caption='PY Metric' datatype='real' name='[CY Metric (copy)_2447882749128714]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 2]&#10;WHEN &apos;Sales&apos; THEN SUM([CY Sales (copy)_0256805467262978])&#10;WHEN &apos;Profit&apos; THEN SUM([PY Sales (copy)_0256805487284235])&#10;WHEN &apos;Quantity&apos; THEN SUM([PY Sales (copy)_2447882742931460])&#10;END' />
