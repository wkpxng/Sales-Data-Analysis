    <worksheet name='KPI Customers'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#626264' fontname='Arial' fontsize='10'>Customers</run>
            <run>Æ&#10;</run>
            <run fontname='Arial' fontsize='18'><![CDATA[<[federated.1nr9bwy05jmnkt10usw9h11sf5fa].[sum:Calculation_0364152768520212:qk]>]]></run>
            <run>Æ&#10;</run>
            <run fontname='Arial' fontsize='9'><![CDATA[<[federated.1nr9bwy05jmnkt10usw9h11sf5fa].[sum:Calculation_0364152768131091:qk]> ]]></run>
            <run fontcolor='#626264' fontname='Arial' fontsize='9'>vs. PY</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales DataSource' name='federated.1nr9bwy05jmnkt10usw9h11sf5fa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Year' datatype='integer' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2026'>
              <calculation class='tableau' formula='2026' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nr9bwy05jmnkt10usw9h11sf5fa'>
            <column caption='% Diff Customers' datatype='real' default-format='p0.0%' name='[% Diff Profit (copy)_0364152767905810]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNTD([CY Profit (copy)_0364152757174272]) - COUNTD([CY Customers (copy)_0364152757612546])) / COUNTD([CY Customers (copy)_0364152757612546])' />
            </column>
            <column caption='PY Customers' datatype='string' name='[CY Customers (copy)_0364152757612546]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1]-1 THEN [Customer ID]&#10;END' />
            </column>
            <column caption='CY Customers' datatype='string' name='[CY Profit (copy)_0364152757174272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1] THEN [Customer ID]&#10;END' />
            </column>
            <column aggregation='Sum' caption='Current Year' datatype='integer' name='[Calculation_0256805476884488]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column aggregation='Sum' caption='Previous Year' datatype='integer' name='[Calculation_0256805477023753]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]-1' />
            </column>
            <column caption='{[% Diff Customers]}' datatype='real' name='[Calculation_0364152768131091]' role='measure' type='quantitative' user:unnamed='KPI Sales (2)'>
              <calculation class='tableau' formula='{[% Diff Profit (copy)_0364152767905810]}' />
            </column>
            <column caption='{COUNTD([CY Customers])}' datatype='integer' name='[Calculation_0364152768520212]' role='measure' type='quantitative' user:unnamed='KPI Sales (2)'>
              <calculation class='tableau' formula='{COUNTD([CY Profit (copy)_0364152757174272])}' />
            </column>
            <column caption='First Order Date' datatype='date' name='[Calculation_2447882826981396]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [Customer ID] : MIN([Order Date])}' />
            </column>
            <column caption='CY Customers New/Repeat' datatype='string' name='[Calculation_2447882827141141]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [First Order Date (copy)_2510280171851776] = [Calculation_2447882826981396] THEN &quot;New&quot; ELSE &quot;Repeat&quot;&#10;END' />
