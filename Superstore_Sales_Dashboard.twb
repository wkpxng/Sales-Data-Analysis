            </column>
            <column caption='CY Profit' datatype='real' name='[CY Sales (copy)_0256805487165450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1] THEN [Profit]&#10;END' />
            </column>
            <column caption='CY Quantity' datatype='integer' name='[CY Sales (copy)_2447882742784002]' role='measure' type='quantitative'>
