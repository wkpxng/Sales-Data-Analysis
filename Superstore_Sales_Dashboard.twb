            <column caption='Min/Max Profit Ratio' datatype='real' name='[Min/Max Profit (copy)_0256805557821464]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF SUM([CY Sales (copy)_0256805487165450])/SUM([Calculation_0256805465968641]) = WINDOW_MAX(SUM([CY Sales (copy)_0256805487165450])/SUM([Calculation_0256805465968641]))&#10;THEN SUM([CY Sales (copy)_0256805487165450])/SUM([Calculation_0256805465968641])&#10;ELSEIF  SUM([CY Sales (copy)_0256805487165450])/SUM([Calculation_0256805465968641]) = WINDOW_MIN(SUM([CY Sales (copy)_0256805487165450])/SUM([Calculation_0256805465968641]))&#10;THEN SUM([CY Sales (copy)_0256805487165450])/SUM([Calculation_0256805465968641])&#10;END'>
