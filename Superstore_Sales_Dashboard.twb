          <datasource-dependencies datasource='federated.1nr9bwy05jmnkt10usw9h11sf5fa'>
            <column caption='% Diff Profit' datatype='real' default-format='p0.0%' name='[% Diff Sales (copy)_0256805487398924]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([CY Sales (copy)_0256805487165450]) - SUM([PY Sales (copy)_0256805487284235])) / ABS(SUM([PY Sales (copy)_0256805487284235]))' />
