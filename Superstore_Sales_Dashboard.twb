            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nr9bwy05jmnkt10usw9h11sf5fa'>
            <column caption='% Diff Profit Ratio' datatype='real' default-format='p0.0%' name='[% Diff Profit (copy)_0256805557633047]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([CY Sales (copy)_0256805487165450])/SUM([Calculation_0256805465968641])-SUM([PY Sales (copy)_0256805487284235])/SUM([CY Sales (copy)_0256805467262978]))/(SUM([PY Sales (copy)_0256805487284235])/SUM([CY Sales (copy)_0256805467262978]))' />
            </column>
            <column caption='PY Sales' datatype='real' name='[CY Sales (copy)_0256805467262978]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1]-1 THEN [Sales]&#10;END' />
            </column>
            <column caption='CY Profit' datatype='real' name='[CY Sales (copy)_0256805487165450]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1] THEN [Profit]&#10;END' />
            </column>
            <column caption='CY Sales' datatype='real' name='[Calculation_0256805465968641]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1] THEN [Sales]&#10;END' />
            </column>
            <column aggregation='Sum' caption='Current Year' datatype='integer' name='[Calculation_0256805476884488]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]' />
            </column>
            <column aggregation='Sum' caption='Previous Year' datatype='integer' name='[Calculation_0256805477023753]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='[Parameters].[Parameter 1]-1' />
            </column>
            <column caption='{[% Diff Profit Ratio]}' datatype='real' name='[Calculation_0256805558165529]' role='measure' type='quantitative' user:unnamed='KPI Profit Ratio'>
              <calculation class='tableau' formula='{[% Diff Profit (copy)_0256805557633047]}' />
            </column>
            <column caption='{SUM([CY Profit])/SUM([CY Sales])}' datatype='real' name='[Calculation_0256805560234011]' role='measure' type='quantitative' user:unnamed='KPI Profit Ratio'>
              <calculation class='tableau' formula='{SUM([CY Sales (copy)_0256805487165450])/SUM([Calculation_0256805465968641])}' />
            </column>
            <column caption='SUM([CY Profit])/SUM([CY Sales])' datatype='real' name='[Calculation_0256805561532445]' role='measure' type='quantitative' user:unnamed='KPI Profit Ratio'>
              <calculation class='tableau' formula='SUM([CY Sales (copy)_0256805487165450])/SUM([Calculation_0256805465968641])' />
            </column>
            <column caption='SUM([PY Profit])/SUM([PY Sales])' datatype='real' name='[Calculation_0256805561671710]' role='measure' type='quantitative' user:unnamed='KPI Profit Ratio'>
              <calculation class='tableau' formula='SUM([PY Sales (copy)_0256805487284235])/SUM([CY Sales (copy)_0256805467262978])' />
            </column>
            <column caption='SUM([CY Profit])/SUM([CY Sales])' datatype='real' name='[Calculation_0256805569499170]' role='measure' type='quantitative' user:unnamed='KPI Profit Ratio'>
              <calculation class='tableau' formula='SUM([CY Sales (copy)_0256805487165450])/SUM([Calculation_0256805465968641])' />
            </column>
