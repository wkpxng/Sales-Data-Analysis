    <worksheet name='Segment Color Legend'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontname='Arial' fontsize='8'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Sales DataSource' name='federated.1nr9bwy05jmnkt10usw9h11sf5fa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Year' datatype='integer' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2026'>
              <calculation class='tableau' formula='2026' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1nr9bwy05jmnkt10usw9h11sf5fa'>
            <column caption='CY Customers' datatype='string' name='[CY Profit (copy)_0364152757174272]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF YEAR([Order Date]) = [Parameters].[Parameter 1] THEN [Customer ID]&#10;END' />
            </column>
            <column caption='avg(-1)' datatype='real' name='[Calculation_0085629628289041]' role='measure' type='quantitative' user:unnamed='Color Legend'>
              <calculation class='tableau' formula='avg(-1)' />
            </column>
            <column caption='First Order Date' datatype='date' name='[Calculation_2447882826981396]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='{FIXED [Customer ID] : MIN([Order Date])}' />
            </column>
            <column caption='CY Customers New/Repeat' datatype='string' name='[Calculation_2447882827141141]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [First Order Date (copy)_2510280171851776] = [Calculation_2447882826981396] THEN &quot;New&quot; ELSE &quot;Repeat&quot;&#10;END' />
            </column>
            <column caption='COUNTD([CY Customers]) / TOTAL(COUNTD([CY Customers]))' datatype='real' name='[Calculation_2447882877870132]' role='measure' type='quantitative' user:unnamed='Segment Color Legend'>
              <calculation class='tableau' formula='COUNTD([CY Profit (copy)_0364152757174272]) / TOTAL(COUNTD([CY Profit (copy)_0364152757174272]))'>
                <table-calc ordering-type='Rows' />
